generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model candidate {
  id                  Int               @id(map: "profile_pkey") @default(autoincrement())
  full_name           String?
  phone               String?
  email               String?
  years_of_experience Int?
  preferred_work_mode work_mode?
  preferred_location  String?
  user_id             Int
  user                user              @relation(fields: [user_id], references: [id], onDelete: Cascade, map: "fk_user_candidate")
  education           education[]
  work_experience     work_experience[]
  skills              candidate_skill[]
}

model candidate_skill {
  candidate_id Int      
  skill_id     Int
  
  candidates candidate @relation(fields: [candidate_id], references: [id], onDelete: Cascade, map: "fk_candidate_skill_candidate")
  skills skill @relation(fields: [skill_id], references: [id], onDelete: Cascade, map: "fk_candidate_skill_skill")

  @@id([candidate_id, skill_id])
  @@index([candidate_id])
  @@index([skill_id])
}

model company {
  id          Int        @id @default(autoincrement())
  name        String?
  description String?
  website     String?
  industry    String?
  email       String?
  phone       String?
  location    String?
  employer    employer[]
}

model education {
  id              Int                 @id @default(autoincrement())
  candidate_id    Int?
  institution     String?
  degree          String?
  field_of_study  String?
  education_level level_of_education?
  candidate       candidate?          @relation(fields: [candidate_id], references: [id], onDelete: Cascade, map: "fk_candidate")
}

model employer {
  id         Int      @id @default(autoincrement())
  user_id    Int?
  company_id Int?
  company    company? @relation(fields: [company_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_employer_company")
  user       user?    @relation(fields: [user_id], references: [id], onDelete: Cascade, map: "fk_employer_user")
  job        job[]
}

model job {
  id                       Int                 @id @default(autoincrement())
  title                    String?
  description              String?
  required_education_level level_of_education?
  years_of_experience      Int?
  work_mode                work_mode?
  location                 String?
  employer_id              Int?
  employer                 employer?           @relation(fields: [employer_id], references: [id], onDelete: Cascade, map: "fk_job_employer")
  job_skills               job_skill[]
}

model skill {
  id              Int               @id @default(autoincrement())
  name            String?           @unique
  candidates candidate_skill[]
  job_skills      job_skill[]
}

model user {
  id           Int                 @id @default(autoincrement())
  email        String              @unique
  password     String
  role         user_role?
  subscription subscription_plans?
  candidate    candidate[]
  employer     employer[]
}

model work_experience {
  id           Int        @id @default(autoincrement())
  candidate_id Int?
  company      String?
  job_title    String?
  description  String?
  start_date   DateTime?  @db.Date
  end_date     DateTime?  @db.Date
  candidate    candidate? @relation(fields: [candidate_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_candidate_work_experience")
}

model job_skill {
  skill_id Int
  job_id   Int
  job      job   @relation(fields: [job_id], references: [id])
  skill    skill @relation(fields: [skill_id], references: [id])

  @@id([skill_id, job_id], map: "pk_skill_job")
  @@index([skill_id, job_id], map: "idx_pk_job_skill")
}

enum level_of_education {
  HIGH_SCHOOL
  DIPLOMA
  BACHELORS
  MASTERS
  PHD
}

enum subscription_plans {
  FREE
  PREMIUM
}

enum user_role {
  SEEKER
  EMPLOYER
}

enum work_mode {
  REMOTE
  ON_SITE
  HYBRID
}
